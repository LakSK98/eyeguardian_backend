# EyeGUARDIAN Vision - Environment Configuration Example

# Server host & port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Allowed Origin (set to frontend origin)
FRONTEND_ORIGIN=http://localhost:3000

# SQLite Database Connection URL
DATABASE_URL=sqlite:///./eyeguardian.db

# Image Upload & Processing Thresholds (Prototype Demonstration)
MAX_UPLOAD_SIZE_MB=10
BLUR_THRESHOLD=40.0
BRIGHTNESS_MIN=35.0
BRIGHTNESS_MAX=230.0
